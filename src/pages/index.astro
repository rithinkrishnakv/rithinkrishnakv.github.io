---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE, LINKS } from "@/lib/site";

const notes = await getCollection("notes", (n) => !n.data.draft);
const builds = (await getCollection("builds")).sort((a, b) => b.data.weight - a.data.weight);
const commonsFiles = await getCollection("commons");
const commonsCount = commonsFiles.reduce((sum, file) => sum + file.data.length, 0);

const topBuilds = builds.slice(0, 3);

const primaryLinks = [
  { label: "Portfolio", href: LINKS.portfolio },
  { label: "GitHub", href: LINKS.github },
  { label: "LinkedIn", href: LINKS.linkedin },
  { label: "X / Twitter", href: LINKS.x },
];
---

<BaseLayout title={SITE.name}>
  <section class="hero wrap">
    <p class="meta text-accent-alt" data-intro style="animation-delay: 0ms;">{SITE.role}</p>
    <h1 data-intro style="animation-delay: 80ms;">{SITE.name}</h1>

    <div class="hero__copy" data-intro-group>
      <p>I like taking things apart.</p>
      <p>
        Sometimes that's a web application. Sometimes it's an API, a security
        tool, a piece of code, or a system that makes no sense until you
        stare at it for way too long.
      </p>
      <p>
        I learn a lot by doing stupid things on purpose and then figuring
        out why they worked.
      </p>
      <p>
        I'm interested in security research, bug hunting, digital
        investigations, automation, and building small tools when the
        existing ones annoy me.
      </p>
      <p class="text-secondary">This isn't my portfolio.</p>
      <p>It's just a place to put things I don't want to forget.</p>
      <p class="text-secondary">
        A bug that turned into a lesson.<br />
        A tool I built because I was curious.<br />
        Something interesting I found while researching.<br />
        A question I couldn't leave alone.<br />
        Sometimes just a thought that seemed worth writing down.
      </p>
      <p>There probably won't be a new post every week.</p>
      <p class="text-secondary">I don't have that many things to say.</p>
      <p>But when I do have something worth saying, it'll end up here.</p>
    </div>

  </section>

  <p class="wrap divider meta" data-reveal>
    Some things are worth documenting before they become another tab you forgot to close.
  </p>

  <section class="section">
    <div class="wrap" data-reveal-group>
      <h2>Notes</h2>
      {
        notes.length === 0 ? (
          <>
            <p class="text-secondary">There aren't any yet.</p>
            <p class="text-secondary">That's fine.</p>
            <p>
              This is where the things that don't deserve a full project,
              write-up, or another twelve browser tabs will end up. Maybe a
              security rabbit hole. Maybe something learned the hard way.
              Maybe just a question that wouldn't let go.
            </p>
            <p>When there's something worth writing, it'll show up here.</p>
          </>
        ) : (
          <ul class="teaser-list">
            {notes.slice(0, 3).map((note) => (
              <li>
                <a href={`/notes/${note.id}/`} class="link">
                  {note.data.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a href="/notes/" class="link link--accent">
        All notes <span class="link__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <hr class="wrap wrap--wide" data-reveal-line />
    <div class="wrap">
      <h2>Security commons</h2>
      <p class="text-secondary">
        A shared index of tools, extensions, references, and other things
        the security world keeps around — assembled from public projects,
        not built by me.
      </p>
      {
        commonsCount > 0 && (
          <p class="meta categories text-accent-alt">{commonsCount} entries, searchable</p>
        )
      }
      <a href="/commons/" class="link link--accent">
        Explore the commons <span class="link__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <hr class="wrap wrap--wide" data-reveal-line />
    <div class="wrap">
      <h2>Things I've built</h2>
      <p class="text-secondary">
        Sometimes writing about a problem isn't enough, so I build something.
        Official projects only — this isn't everything I've touched, just
        what's real and current.
      </p>
      <ul class="teaser-list">
        {
          topBuilds.map((build) => (
            <li>
              <a href="/builds/" class="link">
                {build.data.name}
              </a>
              <span class="meta"> — {build.data.visibility === "private" ? "private" : build.data.status}</span>
            </li>
          ))
        }
      </ul>
      <a href="/builds/" class="link link--accent">
        All builds <span class="link__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <h2>Currently</h2>
      <p class="text-secondary">Learning. Breaking things. Fixing them.</p>
      <p class="text-secondary">Then breaking them again.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal-group>
      <h2>Elsewhere</h2>
      <ul class="teaser-list teaser-list--inline">
        {
          primaryLinks.map((item) => (
            <li>
              <a href={item.href} class="link" target="_blank" rel="noopener noreferrer">
                {item.label}
                <span class="link__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <p class="wrap divider meta" data-reveal>
    This site will probably look different later. That's fine — I'm still figuring things out.
    Built on the open web.
  </p>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 7rem) clamp(2.5rem, 6vw, 4rem);
    position: relative;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: -10rem;
    left: 50%;
    transform: translateX(-50%);
    width: 150%;
    height: 150%;
    background: radial-gradient(ellipse at top center, rgba(99, 132, 255, 0.04), transparent 60%);
    pointer-events: none;
    z-index: -1;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    margin-block: 0.4em 1.2em;
  }

  .hero__copy p {
    max-width: var(--measure);
  }

  .divider {
    padding-block: 2rem;
    max-width: var(--measure-wide);
  }

  .teaser-list {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .teaser-list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .categories {
    margin-top: -0.5rem;
  }

  h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  [data-reveal-line] {
    margin-bottom: 2.5rem;
  }

  .section .link--accent {
    display: inline-flex;
    margin-top: 0.75rem;
  }
</style>
