---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", (n) => !n.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<BaseLayout
  title="Notes"
  description="Notes on security research, tools, and things worth remembering. Currently empty — on purpose."
>
  <section class="section section--first">
    <div class="wrap">
      <h1 data-intro>Notes</h1>

      {
        notes.length === 0 ? (
          <div class="empty" data-reveal-group>
            <p class="text-secondary">No notes yet.</p>
          </div>
        ) : (
          <ul class="notes-list" data-reveal-group>
            {notes.map((note) => (
              <li class="notes-list__item">
                <a href={`/notes/${note.id}/`} class="notes-list__link">
                  <span class="notes-list__title">{note.data.title}</span>
                  {note.data.summary && (
                    <span class="notes-list__summary text-secondary">
                      {note.data.summary}
                    </span>
                  )}
                  <span class="meta">{dateFmt.format(note.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        notes.length > 0 && (
          <p class="meta"><a href="/rss.xml" class="link">Subscribe via RSS →</a></p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section--first {
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 2rem;
  }

  .empty p {
    max-width: var(--measure);
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-soft);
  }

  .notes-list__item {
    border-bottom: 1px solid var(--border-soft);
  }

  .notes-list__link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-block: 1.5rem;
    text-decoration: none;
    color: var(--text);
    transition: transform var(--dur-base) var(--ease-physical);
  }

  .notes-list__link:hover,
  .notes-list__link:focus-visible {
    transform: translateX(4px);
  }

  .notes-list__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .notes-list__link:hover .notes-list__title,
  .notes-list__link:focus-visible .notes-list__title {
    color: var(--accent);
  }
</style>
