---
import { getCollection, render } from "astro:content";
import NoteLayout from "@/layouts/NoteLayout.astro";

export async function getStaticPaths() {
  const notes = (await getCollection("notes", (n) => !n.data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );

  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: {
      note,
      prev: notes[i - 1] ? { id: notes[i - 1].id, title: notes[i - 1].data.title } : null,
      next: notes[i + 1] ? { id: notes[i + 1].id, title: notes[i + 1].data.title } : null,
    },
  }));
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);
---

<NoteLayout
  title={note.data.title}
  subtitle={note.data.subtitle}
  date={note.data.date}
  updated={note.data.updated}
  tags={note.data.tags}
  summary={note.data.summary}
  prev={prev}
  next={next}
>
  <Content />
</NoteLayout>
