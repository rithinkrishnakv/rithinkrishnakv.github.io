---
import Nav from "@/components/Nav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { SITE } from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Set to false on pages like 404 that shouldn't be indexed. */
  index?: boolean;
  /** Open Graph type. Use "article" for note pages. Defaults to "website". */
  ogType?: "website" | "article";
  /**
   * Site-relative path (e.g. "/og/my-note.png") or absolute URL to the
   * Open Graph preview image for this page. Falls back to the default OG image.
   */
  ogImage?: string;
  /** Alt text for the OG image. */
  ogImageAlt?: string;
}

const {
  title,
  description = SITE.description,
  index = true,
  ogType = "website",
  ogImage,
  ogImageAlt,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} — ${SITE.shortName}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);

// Resolve the OG image to an absolute HTTPS URL.
// Priority: prop value → default image.
const DEFAULT_OG_IMAGE = "/og/github-avatar.png";
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 1200;

function resolveOgImage(path: string): string {
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return new URL(path, SITE.url).toString();
}

const resolvedOgImage = resolveOgImage(ogImage ?? DEFAULT_OG_IMAGE);
const resolvedOgImageAlt =
  ogImageAlt ?? `Social preview image for ${pageTitle}`;

// Use summary_large_image card to show the preview image in social apps.
const twitterCard = "summary_large_image";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {!index && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Reveal-on-scroll: adds `.is-visible` once an element (or a group's
      // container) enters the viewport. CSS handles the actual transition,
      // and `prefers-reduced-motion` short-circuits it in global.css.
      const targets = document.querySelectorAll(
        "[data-reveal], [data-reveal-group], [data-reveal-line]"
      );

      if ("IntersectionObserver" in window && targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );

        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
