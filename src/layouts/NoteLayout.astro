---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  updated?: Date;
  tags: string[];
  summary?: string;
  prev?: { id: string; title: string } | null;
  next?: { id: string; title: string } | null;
}

const { title, subtitle, date, updated, tags, summary, prev, next } = Astro.props;

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={summary}>
  <article class="note">
    <header class="note__header wrap" data-reveal-group>
      <p class="meta">
        {dateFmt.format(date)}
        {updated && <> · updated {dateFmt.format(updated)}</>}
      </p>
      <h1>{title}</h1>
      {subtitle && <p class="note__subtitle text-secondary">{subtitle}</p>}
      {
        tags.length > 0 && (
          <ul class="note__tags">
            {tags.map((tag) => (
              <li class="meta">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="note__body wrap" data-reveal>
      <slot />
    </div>

    <nav class="note__nav wrap" aria-label="Note navigation" data-reveal>
      <a href="/notes/" class="link">← all notes</a>
      <div class="note__adjacent">
        {prev && (
          <a href={`/notes/${prev.id}/`} class="link">
            ← {prev.title}
          </a>
        )}
        {next && (
          <a href={`/notes/${next.id}/`} class="link">
            {next.title} →
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .note__header {
    padding-block: clamp(3rem, 8vw, 5rem) 2rem;
  }

  .note__header h1 {
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    margin-block: 0.5em 0.3em;
  }

  .note__subtitle {
    font-size: 1.1rem;
  }

  .note__tags {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .note__body {
    max-width: var(--measure);
    padding-block: 1rem 3rem;
    font-size: 1.05rem;
  }

  .note__body :global(h2) {
    font-size: 1.4rem;
    margin-block: 2em 0.6em;
  }

  .note__body :global(h3) {
    font-size: 1.15rem;
    margin-block: 1.6em 0.5em;
  }

  .note__body :global(pre) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .note__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-elevated);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .note__body :global(pre code) {
    background: none;
    padding: 0;
  }

  .note__body :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 1.5em 0;
    padding-left: 1.25em;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .note__body :global(img) {
    border-radius: 6px;
    margin-block: 1.5em;
  }

  .note__body :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .note__nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--border-soft);
    margin-top: 2rem;
  }

  .note__adjacent {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
</style>
