---
import { LINKS } from "@/lib/site";

const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="wrap footer__row">
    <p class="meta">
      This site will probably look different later. That's fine — © {year}
    </p>
    <a href={LINKS.email} class="link meta">Contact</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

</style>
